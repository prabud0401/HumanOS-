# HumanOS — Brain Connection
# Copy this file to .env and choose your connection mode

# ── Connection Mode ──────────────────────────────────────────
# "api" = Use Anthropic API (requires API key below)
# "cli" = Use Claude CLI locally (no API key needed, uses your Claude subscription)
# If not set, auto-detects: uses API if key is present, otherwise tries CLI
LLM_MODE=cli

# ── Option 1: API Mode ──────────────────────────────────────
# Get your key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ── Option 2: CLI Mode ──────────────────────────────────────
# Install the Claude CLI first:
#   npm install -g @anthropic-ai/claude-code
# Then authenticate:
#   claude auth login
# That's it — no API key needed.

# ── Optional Settings ────────────────────────────────────────
# Override the default model (works with both API and CLI)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server port (default 3001)
# PORT=3001
