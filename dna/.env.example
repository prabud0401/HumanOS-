# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
TZ=Asia/Colombo

# Azure AD / Microsoft Graph
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Zoom
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# GitHub
GITHUB_TOKEN=ghp_your-token

# Slack
SLACK_BOT_TOKEN=xoxb-your-token

# Communication
TEAMS_WEBHOOK_URL=https://your-webhook-url
EMAIL_ADDRESS=your@email.com

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://humanos:humanos_dev@localhost:5432/humanos
REDIS_URL=redis://localhost:6379/0
CHROMA_URL=http://localhost:8100

# AI
CLAUDE_API_KEY=sk-ant-your-key
OPENAI_API_KEY=sk-your-key

# Storage
AZURE_STORAGE_CONNECTION_STRING=your-connection-string

# Security
ENCRYPTION_KEY=generate-a-256-bit-key
JWT_SECRET=generate-a-secret
